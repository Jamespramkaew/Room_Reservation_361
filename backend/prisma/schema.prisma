
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Example {
  id      String @id @default(uuid())
  author  String @unique
  comment String @default("Hello world!")
}

enum UserRole {
  STUDENT
  ADMIN
}

enum RoomStatus {
  AVAILABLE
  MAINTENANCE
  RESERVED
}

enum RoomSize {
  SMALL
  MEDIUM
  LARGE
}

model User {
  id                String   @id @default(uuid())
  username          String   @unique
  password_hash     String
  role              UserRole @default(STUDENT)
  email             String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  deleted_at        DateTime?

  bookings          Booking[] @relation("UserBookings")
  cancelledBookings Booking[] @relation("CancelledByUser")
}

model Room {
  id              String     @id @default(uuid())
  room_name       String     @unique
  description     String?
  seat_capacity   Int
  status          RoomStatus
  size            RoomSize
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt
  deleted_at      DateTime?

  bookings        Booking[]
  room_photos     RoomPhotos[]
  room_facilities RoomFacilities[]
}

enum BookingType {
  CLASS
  SCHEDULE
  SPECIAL_EVENT
  STUDENT_BOOKING
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Booking {
  id            String        @id @default(uuid())
  user_id       String
  room_id       String
  booking_type  BookingType
  title         String?
  start_time    DateTime
  end_time      DateTime
  status        BookingStatus @default(PENDING)
  remark        String?
  cancelled_by  String?
  cancel_reason String?
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  cancelled_at  DateTime?

  user            User  @relation("UserBookings", fields: [user_id], references: [id], onDelete: Cascade)
  cancelledByUser User? @relation("CancelledByUser", fields: [cancelled_by], references: [id])
  room            Room  @relation(fields: [room_id], references: [id])
}

model RoomPhotos {
  id         String   @id @default(uuid())
  room_id    String
  object_key String
  caption    String?
  sort_order Int      @default(0)
  created_at DateTime @default(now())

  room Room @relation(fields: [room_id], references: [id], onDelete: Cascade)
}

model Facilities {
  id              String   @id @default(uuid())
  name            String   @unique
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  room_facilities RoomFacilities[]
}

model RoomFacilities {
  id              String    @id @default(uuid())
  room_id         String
  facility_id     String
  quantity        Int       @default(1)
  broken_quantity Int       @default(0)
  sort_order      Int       @default(0)
  note            String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  room     Room       @relation(fields: [room_id], references: [id], onDelete: Cascade)
  facility Facilities @relation(fields: [facility_id], references: [id])

  @@unique([room_id, facility_id])
}
