# Deploy target: real AWS. Copy to aws.env (gitignored: it holds the DB password).
AWS_PROFILE=default
REGION=ap-southeast-1
STAGE_NAME=dev

# Private subnets + security group that can reach RDS on 5432. Leave empty to run outside a VPC.
VPC_SUBNET_IDS=subnet-aaaa,subnet-bbbb
VPC_SECURITY_GROUP_IDS=sg-xxxx

# Every FN_ENV_* variable becomes a Lambda environment variable (prefix removed).
# Do not set AWS_REGION or AWS_ACCESS_KEY_ID here: Lambda reserves them.
FN_ENV_STAGE=dev
FN_ENV_DATABASE_URL=postgresql://postgres:CHANGE_ME@your-db.xxxx.ap-southeast-1.rds.amazonaws.com:5432/platform?sslmode=require
FN_ENV_ALLOWED_ORIGINS=https://your-frontend.example.com
FN_ENV_S3_BUCKET=roomres-dev-photos
FN_ENV_S3_PUBLIC_URL=https://roomres-dev-photos.s3.ap-southeast-1.amazonaws.com
